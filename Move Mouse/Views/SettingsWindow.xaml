                        <Image Grid.Row="10" Grid.Column="0" Source="/Resources/Timer_Dark_64x64.png"/>
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="{Binding Path=SystemIdleTime, Mode=OneWay, NotifyOnTargetUpdated=True, StringFormat='Tempo ocioso do sistema - {0:hh}h {0:mm}m {0:ss}s {0:fff}ms'}"/>
                    </Grid>
                    <Image Source="/Resources/Mouse.ico" HorizontalAlignment="Right" VerticalAlignment="Top" Width="96" Height="96"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Button AutomationProperties.Name="Close settings" Content="Fechar" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,20" Click="CloseButton_OnClick"/>
        <Border BorderThickness="5" BorderBrush="{StaticResource StandardBorderBrush}"/>
    </Grid>
</Window>